// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum AppointmentSource {
  ONLINE
  ADMIN
}

enum AdminRole {
  OWNER
  ADMIN
  STAFF
}

// Estados normalizados de una verificación de cobertura. NOT_AVAILABLE/
// SOURCE_UNAVAILABLE/UNKNOWN/MANUAL_VERIFICATION_REQUIRED nunca deben
// mostrarse al staff como "cobertura activa" (ver COVERAGE_ENGINE.md).
enum CoverageState {
  ACTIVE
  INACTIVE
  BLOCKED
  SUSPENDED
  NOT_FOUND
  AUTHORIZATION_REQUIRED
  NOT_COVERED
  SOURCE_UNAVAILABLE
  UNKNOWN
  MANUAL_VERIFICATION_REQUIRED
}

// Disponibilidad del conector que produjo una CoverageVerification. Hoy
// todos los conectores son NOT_AVAILABLE (sin integración oficial real);
// ver src/lib/coverage/providers/unavailable-provider.ts.
enum CoverageConnectorStatus {
  NOT_AVAILABLE
  AVAILABLE
  DEGRADED
}

// Estado del convenio/registro oficial de un profesional con una obra
// social (RNP u homólogo), separado de la simple lista "la acepto en el
// wizard" (Professional.insuranceProviders).
enum ProviderAgreementStatus {
  ACTIVE
  PENDING
  SUSPENDED
  TERMINATED
  UNKNOWN
}

// ============================================================
// CLINIC / CONFIGURATION (singleton row, id = 1)
// ============================================================

model Clinic {
  id                Int      @id @default(autoincrement())
  name              String   @default("Mi Clínica")
  tagline           String   @default("Turnos online las 24 horas")
  logoUrl           String?
  primaryColor      String   @default("#0d9488")
  address           String?
  phone             String?
  whatsapp          String?
  email             String?
  instagram         String?
  timezone          String   @default("America/Argentina/Buenos_Aires")
  slotDurationMin   Int      @default(30)
  minNoticeHours    Int      @default(2)
  maxAdvanceDays    Int      @default(60)
  allowCancelation  Boolean  @default(true)
  cancelNoticeHours Int      @default(24)
  currency          String   @default("ARS")
  welcomeMessage    String   @default("Reservá tu turno online en simples pasos.")
  updatedAt         DateTime @updatedAt
}

// ============================================================
// USERS (admin / staff)
// ============================================================

model AdminUser {
  id             String        @id @default(cuid())
  name           String
  email          String        @unique
  passwordHash   String
  role           AdminRole     @default(STAFF)
  active         Boolean       @default(true)
  // Vínculo opcional 1 a 1: cuando un usuario del panel es a la vez un
  // profesional, este campo le da acceso de "autogestión" (ver Mi perfil)
  // restringido a su propia agenda, horarios y datos de perfil.
  professional   Professional? @relation(fields: [professionalId], references: [id], onDelete: SetNull)
  professionalId String?       @unique
  coverageVerifications CoverageVerification[]
  createdAt      DateTime      @default(now())
}

// ============================================================
// PROFESSIONALS
// ============================================================

model Professional {
  id                 String              @id @default(cuid())
  name               String
  specialty          String?
  bio                String?
  photoUrl           String?
  color              String              @default("#0d9488")
  active             Boolean             @default(true)
  order              Int                 @default(0)
  services           Service[]           @relation("ProfessionalServices")
  workingHours       WorkingHour[]
  blockedSlots       BlockedSlot[]
  appointments       Appointment[]
  adminUser          AdminUser?
  // Si pide obra social/prepaga al reservar: si es false, el paciente nunca
  // ve ese paso y todo se trata como particular (comportamiento de siempre).
  asksInsurance      Boolean             @default(false)
  insuranceProviders InsuranceProvider[] @relation("ProfessionalInsuranceProviders")
  copayRules         CopayRule[]
  providerAgreements ProviderAgreement[]
  createdAt          DateTime            @default(now())
}

// ============================================================
// SERVICES (tipos de consulta)
// ============================================================

model Service {
  id                   String         @id @default(cuid())
  name                 String
  description          String?
  durationMin          Int            @default(30)
  price                Float          @default(0)
  color                String         @default("#0d9488")
  active               Boolean        @default(true)
  order                Int            @default(0)
  professionals        Professional[] @relation("ProfessionalServices")
  appointments         Appointment[]
  extraForAppointments Appointment[]  @relation("AppointmentExtraServices")
  combos               ServiceCombo[] @relation("ComboServices")
  copayRules           CopayRule[]
  createdAt            DateTime       @default(now())
}

// ============================================================
// SERVICE COMBOS (combinaciones de servicios con precio/duración propios)
// ============================================================

model ServiceCombo {
  id           String        @id @default(cuid())
  name         String?
  services     Service[]     @relation("ComboServices")
  // null = se calcula como la suma de los precios/duraciones individuales
  price        Float?
  durationMin  Int?
  active       Boolean       @default(true)
  order        Int           @default(0)
  createdAt    DateTime      @default(now())
  appointments Appointment[]
}

// ============================================================
// INSURANCE PROVIDERS (obras sociales / prepagas)
// ============================================================

model InsuranceProvider {
  id            String         @id @default(cuid())
  name          String
  active        Boolean        @default(true)
  order         Int            @default(0)
  // Coseguro/copago habitual de esta cobertura: sólo un valor de referencia
  // para autocompletar al cargar un turno; el staff lo puede corregir.
  defaultCopayment Float?
  // Clave del conector del motor de cobertura (ej. "PAMI", "OSDE"). Null =
  // sin integración conocida, se resuelve siempre al conector genérico "no
  // disponible". No afecta nada del comportamiento actual del wizard/admin.
  connectorKey  String?
  professionals Professional[] @relation("ProfessionalInsuranceProviders")
  patients      Patient[]
  appointments  Appointment[]
  copayRules    CopayRule[]
  providerAgreements   ProviderAgreement[]
  coverageVerifications CoverageVerification[]
  createdAt     DateTime       @default(now())
}

// ============================================================
// WORKING HOURS (horario semanal recurrente por profesional)
// ============================================================

model WorkingHour {
  id             String       @id @default(cuid())
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  professionalId String
  weekday        Int // 0 = domingo ... 6 = sábado
  startTime      String // "09:00"
  endTime        String // "13:00"
  active         Boolean      @default(true)

  @@index([professionalId, weekday])
}

// ============================================================
// BLOCKED SLOTS (feriados, vacaciones, bloqueos puntuales)
// ============================================================

model BlockedSlot {
  id             String        @id @default(cuid())
  professional   Professional? @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  professionalId String?
  date           String // "2026-08-21"
  startTime      String? // null = todo el día
  endTime        String?
  reason         String?
  createdAt      DateTime      @default(now())

  @@index([professionalId, date])
}

// ============================================================
// PATIENTS
// ============================================================

model Patient {
  id                    String             @id @default(cuid())
  firstName             String
  lastName              String
  dni                   String?
  phone                 String
  email                 String?
  birthDate             String?
  notes                 String?
  // Cobertura de referencia del paciente (queda guardada de la última vez
  // que la cargó); cada turno puede tener la suya propia igual, por si
  // cambia entre visitas.
  insuranceProvider     InsuranceProvider? @relation(fields: [insuranceProviderId], references: [id], onDelete: SetNull)
  insuranceProviderId   String?
  insuranceMemberNumber String?
  appointments          Appointment[]
  coverageVerifications CoverageVerification[]
  createdAt             DateTime           @default(now())

  @@index([phone])
  @@index([dni])
}

// ============================================================
// APPOINTMENTS
// ============================================================

model Appointment {
  id                    String             @id @default(cuid())
  patient               Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientId             String
  professional          Professional       @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  professionalId        String
  service               Service            @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  serviceId             String
  // Servicios adicionales combinados en este mismo turno (más allá del
  // "primario" de arriba). Vacío = turno de un solo servicio (caso de
  // siempre, sin cambios de comportamiento).
  extraServices         Service[]          @relation("AppointmentExtraServices")
  // Combo configurado que matcheó la combinación elegida (precio/duración
  // propios), si corresponde. Null = se usa la suma de los servicios.
  combo                 ServiceCombo?      @relation(fields: [comboId], references: [id], onDelete: SetNull)
  comboId               String?
  date                  String // "2026-08-21"
  startTime             String // "09:00"
  endTime               String // "09:30"
  status                AppointmentStatus  @default(PENDING)
  source                AppointmentSource  @default(ONLINE)
  notes                 String?
  cancelReason          String?
  cancelToken           String             @unique @default(cuid())
  // Cobertura usada en ESTE turno puntual (puede diferir de la que el
  // paciente tiene guardada) y el coseguro/copago, que normalmente el
  // staff completa una vez que lo confirma con la obra social.
  insuranceProvider     InsuranceProvider? @relation(fields: [insuranceProviderId], references: [id], onDelete: SetNull)
  insuranceProviderId   String?
  insuranceMemberNumber String?
  copaymentAmount       Float?
  // Marcado manualmente por el staff tras confirmar la cobertura (llamando
  // a la obra social o revisando su portal). No hay forma de verificarlo
  // automáticamente: cada obra social tiene su propio sistema interno.
  insuranceVerified       Boolean          @default(false)
  insuranceVerifiedUntil  String? // "2026-08-21", fecha de vencimiento informada
  coverageVerifications CoverageVerification[]
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  // Igual a "professionalId|date|startTime" mientras el turno está activo
  // (no cancelado), y null si está cancelado. El índice único de abajo
  // evita que dos reservas concurrentes se queden con el mismo horario;
  // al ser null en los cancelados, ese horario vuelve a quedar libre para
  // que otro turno lo use. Se mantiene en código (ver src/lib/actions/appointments.ts).
  activeSlotKey         String?            @unique

  @@index([date, professionalId])
  @@index([patientId])
}

// ============================================================
// RATE LIMITING (login y reserva pública)
// ============================================================

model RateLimitEntry {
  key         String   @id // ej: "login:email@x.com" o "booking:190.1.2.3"
  count       Int      @default(1)
  windowStart DateTime @default(now())
}

// ============================================================
// COVERAGE ENGINE (motor de verificación de cobertura)
//
// Módulo desacoplado: formaliza y audita lo que hoy es un chequeo manual
// (ver Appointment.insuranceVerified) sin reemplazarlo. Ningún organismo
// (SSSalud/PAMI/IOMA/prepagas) publica hoy una API oficial abierta para
// verificar cobertura por software desde una clínica privada — ver
// COVERAGE_ENGINE.md. Por eso todo conector real vive en
// src/lib/coverage/providers/ como un stub NOT_AVAILABLE hasta que exista
// un mecanismo oficial documentado y la clínica esté autorizada a usarlo.
// ============================================================

// Registro de auditoría de cada verificación de cobertura, manual o
// automática. Nunca guarda el DNI ni el número de afiliado completos (ver
// src/lib/coverage/domain/redact.ts) ni tokens/credenciales.
model CoverageVerification {
  id                  String                  @id @default(cuid())
  appointment         Appointment?            @relation(fields: [appointmentId], references: [id], onDelete: SetNull)
  appointmentId       String?
  patient             Patient?                @relation(fields: [patientId], references: [id], onDelete: SetNull)
  patientId           String?
  insuranceProvider   InsuranceProvider?      @relation(fields: [insuranceProviderId], references: [id], onDelete: SetNull)
  insuranceProviderId String?
  requestedBy         AdminUser?              @relation(fields: [requestedById], references: [id], onDelete: SetNull)
  requestedById       String?
  source              AppointmentSource
  state               CoverageState
  connectorStatus     CoverageConnectorStatus @default(NOT_AVAILABLE)
  sourceId            String // "UNAVAILABLE_OFFICIAL:PAMI" | "MANUAL_STAFF" | futuro conector real
  memberNumberMasked  String? // sólo últimos 4 dígitos, nunca el número completo
  suggestedCopaymentAmount Decimal?           @db.Decimal(10, 2)
  durationMs          Int?
  message             String? // texto seguro para mostrar al staff, sin PII adicional
  createdAt           DateTime                @default(now())

  @@index([insuranceProviderId, createdAt])
  @@index([appointmentId])
  @@index([patientId])
}

// Regla de coseguro con alcance fino (obra social + profesional + servicio
// opcionales). No reemplaza InsuranceProvider.defaultCopayment: la
// resolución cae en ese valor cuando ninguna regla matchea (ver
// src/lib/coverage/domain/copay-resolution.ts).
model CopayRule {
  id                  String             @id @default(cuid())
  insuranceProvider   InsuranceProvider  @relation(fields: [insuranceProviderId], references: [id], onDelete: Cascade)
  insuranceProviderId String
  professional        Professional?      @relation(fields: [professionalId], references: [id], onDelete: SetNull)
  professionalId      String?
  service             Service?           @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  serviceId           String?
  planName            String? // texto libre (ej. "OSDE 210"): no hay catálogo de planes por obra social
  copaymentAmount     Decimal            @db.Decimal(10, 2)
  active              Boolean            @default(true)
  notes               String?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([insuranceProviderId, professionalId, serviceId])
}

// Convenio/registro oficial de un profesional con una obra social (estado
// RNP u homólogo), separado a propósito de la relación M2M simple
// Professional.insuranceProviders (que sólo dice "la acepto en el wizard").
model ProviderAgreement {
  id                  String                   @id @default(cuid())
  professional        Professional             @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  professionalId      String
  insuranceProvider   InsuranceProvider        @relation(fields: [insuranceProviderId], references: [id], onDelete: Cascade)
  insuranceProviderId String
  status              ProviderAgreementStatus  @default(UNKNOWN)
  rnpCode             String? // código de Registro Nacional de Prestadores u homólogo, formato libre
  effectiveFrom       DateTime?
  effectiveTo         DateTime?
  notes               String?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  @@unique([professionalId, insuranceProviderId])
}
