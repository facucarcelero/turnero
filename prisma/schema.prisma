// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum AppointmentSource {
  ONLINE
  ADMIN
}

enum AdminRole {
  OWNER
  ADMIN
  STAFF
}

// ============================================================
// CLINIC / CONFIGURATION (singleton row, id = 1)
// ============================================================

model Clinic {
  id                Int      @id @default(autoincrement())
  name              String   @default("Mi Clínica")
  tagline           String   @default("Turnos online las 24 horas")
  logoUrl           String?
  primaryColor      String   @default("#0d9488")
  address           String?
  phone             String?
  whatsapp          String?
  email             String?
  instagram         String?
  timezone          String   @default("America/Argentina/Buenos_Aires")
  slotDurationMin   Int      @default(30)
  minNoticeHours    Int      @default(2)
  maxAdvanceDays    Int      @default(60)
  allowCancelation  Boolean  @default(true)
  cancelNoticeHours Int      @default(24)
  currency          String   @default("ARS")
  welcomeMessage    String   @default("Reservá tu turno online en simples pasos.")
  updatedAt         DateTime @updatedAt
}

// ============================================================
// USERS (admin / staff)
// ============================================================

model AdminUser {
  id             String        @id @default(cuid())
  name           String
  email          String        @unique
  passwordHash   String
  role           AdminRole     @default(STAFF)
  active         Boolean       @default(true)
  // Vínculo opcional 1 a 1: cuando un usuario del panel es a la vez un
  // profesional, este campo le da acceso de "autogestión" (ver Mi perfil)
  // restringido a su propia agenda, horarios y datos de perfil.
  professional   Professional? @relation(fields: [professionalId], references: [id], onDelete: SetNull)
  professionalId String?       @unique
  createdAt      DateTime      @default(now())
}

// ============================================================
// PROFESSIONALS
// ============================================================

model Professional {
  id                 String              @id @default(cuid())
  name               String
  specialty          String?
  bio                String?
  photoUrl           String?
  color              String              @default("#0d9488")
  active             Boolean             @default(true)
  order              Int                 @default(0)
  services           Service[]           @relation("ProfessionalServices")
  workingHours       WorkingHour[]
  blockedSlots       BlockedSlot[]
  appointments       Appointment[]
  adminUser          AdminUser?
  // Si pide obra social/prepaga al reservar: si es false, el paciente nunca
  // ve ese paso y todo se trata como particular (comportamiento de siempre).
  asksInsurance      Boolean             @default(false)
  insuranceProviders InsuranceProvider[] @relation("ProfessionalInsuranceProviders")
  createdAt          DateTime            @default(now())
}

// ============================================================
// SERVICES (tipos de consulta)
// ============================================================

model Service {
  id                   String         @id @default(cuid())
  name                 String
  description          String?
  durationMin          Int            @default(30)
  price                Float          @default(0)
  color                String         @default("#0d9488")
  active               Boolean        @default(true)
  order                Int            @default(0)
  professionals        Professional[] @relation("ProfessionalServices")
  appointments         Appointment[]
  extraForAppointments Appointment[]  @relation("AppointmentExtraServices")
  combos               ServiceCombo[] @relation("ComboServices")
  createdAt            DateTime       @default(now())
}

// ============================================================
// SERVICE COMBOS (combinaciones de servicios con precio/duración propios)
// ============================================================

model ServiceCombo {
  id           String        @id @default(cuid())
  name         String?
  services     Service[]     @relation("ComboServices")
  // null = se calcula como la suma de los precios/duraciones individuales
  price        Float?
  durationMin  Int?
  active       Boolean       @default(true)
  order        Int           @default(0)
  createdAt    DateTime      @default(now())
  appointments Appointment[]
}

// ============================================================
// INSURANCE PROVIDERS (obras sociales / prepagas)
// ============================================================

model InsuranceProvider {
  id            String         @id @default(cuid())
  name          String
  active        Boolean        @default(true)
  order         Int            @default(0)
  professionals Professional[] @relation("ProfessionalInsuranceProviders")
  patients      Patient[]
  appointments  Appointment[]
  createdAt     DateTime       @default(now())
}

// ============================================================
// WORKING HOURS (horario semanal recurrente por profesional)
// ============================================================

model WorkingHour {
  id             String       @id @default(cuid())
  professional   Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  professionalId String
  weekday        Int // 0 = domingo ... 6 = sábado
  startTime      String // "09:00"
  endTime        String // "13:00"
  active         Boolean      @default(true)

  @@index([professionalId, weekday])
}

// ============================================================
// BLOCKED SLOTS (feriados, vacaciones, bloqueos puntuales)
// ============================================================

model BlockedSlot {
  id             String        @id @default(cuid())
  professional   Professional? @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  professionalId String?
  date           String // "2026-08-21"
  startTime      String? // null = todo el día
  endTime        String?
  reason         String?
  createdAt      DateTime      @default(now())

  @@index([professionalId, date])
}

// ============================================================
// PATIENTS
// ============================================================

model Patient {
  id                    String             @id @default(cuid())
  firstName             String
  lastName              String
  dni                   String?
  phone                 String
  email                 String?
  birthDate             String?
  notes                 String?
  // Cobertura de referencia del paciente (queda guardada de la última vez
  // que la cargó); cada turno puede tener la suya propia igual, por si
  // cambia entre visitas.
  insuranceProvider     InsuranceProvider? @relation(fields: [insuranceProviderId], references: [id], onDelete: SetNull)
  insuranceProviderId   String?
  insuranceMemberNumber String?
  appointments          Appointment[]
  createdAt             DateTime           @default(now())

  @@index([phone])
  @@index([dni])
}

// ============================================================
// APPOINTMENTS
// ============================================================

model Appointment {
  id                    String             @id @default(cuid())
  patient               Patient            @relation(fields: [patientId], references: [id], onDelete: Cascade)
  patientId             String
  professional          Professional       @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  professionalId        String
  service               Service            @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  serviceId             String
  // Servicios adicionales combinados en este mismo turno (más allá del
  // "primario" de arriba). Vacío = turno de un solo servicio (caso de
  // siempre, sin cambios de comportamiento).
  extraServices         Service[]          @relation("AppointmentExtraServices")
  // Combo configurado que matcheó la combinación elegida (precio/duración
  // propios), si corresponde. Null = se usa la suma de los servicios.
  combo                 ServiceCombo?      @relation(fields: [comboId], references: [id], onDelete: SetNull)
  comboId               String?
  date                  String // "2026-08-21"
  startTime             String // "09:00"
  endTime               String // "09:30"
  status                AppointmentStatus  @default(PENDING)
  source                AppointmentSource  @default(ONLINE)
  notes                 String?
  cancelReason          String?
  cancelToken           String             @unique @default(cuid())
  // Cobertura usada en ESTE turno puntual (puede diferir de la que el
  // paciente tiene guardada) y el coseguro/copago, que normalmente el
  // staff completa una vez que lo confirma con la obra social.
  insuranceProvider     InsuranceProvider? @relation(fields: [insuranceProviderId], references: [id], onDelete: SetNull)
  insuranceProviderId   String?
  insuranceMemberNumber String?
  copaymentAmount       Float?
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @updatedAt
  // Igual a "professionalId|date|startTime" mientras el turno está activo
  // (no cancelado), y null si está cancelado. El índice único de abajo
  // evita que dos reservas concurrentes se queden con el mismo horario;
  // al ser null en los cancelados, ese horario vuelve a quedar libre para
  // que otro turno lo use. Se mantiene en código (ver src/lib/actions/appointments.ts).
  activeSlotKey         String?            @unique

  @@index([date, professionalId])
  @@index([patientId])
}

// ============================================================
// RATE LIMITING (login y reserva pública)
// ============================================================

model RateLimitEntry {
  key         String   @id // ej: "login:email@x.com" o "booking:190.1.2.3"
  count       Int      @default(1)
  windowStart DateTime @default(now())
}
